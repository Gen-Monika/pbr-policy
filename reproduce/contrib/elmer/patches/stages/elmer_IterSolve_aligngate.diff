@@ -284,6 +284,25 @@
     CALL MPI_BCAST(aligned, 1, MPI_INTEGER, 0, ParEnv % ActiveComm, ierr)
   END FUNCTION PBR_AlignInt
 
+  ! C1b ALIGNGATE: collective OR.  "If ANY rank needs it, ALL ranks take the
+  ! branch."  Used where a branch predicate is per-rank state but the branch
+  ! itself issues a collective: differing predicates would otherwise put ranks
+  ! into different collective sequences and hang.  Widening can only cost an
+  ! extra build, never skip a needed one.
+  FUNCTION PBR_AlignAny(val) RESULT(aligned)
+    LOGICAL, INTENT(IN) :: val
+    LOGICAL :: aligned
+    INTEGER :: local, any, ierr
+    aligned = val
+    IF (.NOT. pbrAlign) RETURN
+    IF (ParEnv % PEs <= 1) RETURN
+    local = 0
+    IF (val) local = 1
+    any = 0
+    CALL MPI_ALLREDUCE(local, any, 1, MPI_INTEGER, MPI_MAX, ParEnv % ActiveComm, ierr)
+    aligned = (any /= 0)
+  END FUNCTION PBR_AlignAny
+
 END MODULE PBROnline
 
 
@@ -1361,7 +1380,12 @@
 
