         IF (PBRon) THEN
-          IF (.NOT.(ASSOCIATED(A % ILUValues).OR.ASSOCIATED(A % CILUValues))) THEN
+          ! C1b ALIGNGATE: this predicate is a local pointer test, but the ELSE
+          ! branch and the later PBR_NoteBuild(PBR_AlignReal(...)) both issue
+          ! collectives.  If ranks disagreed, part of them would call a BCAST the
+          ! rest never match.  Decide it collectively: any rank needing a first
+          ! build makes all of them take that branch.
+          IF (PBR_AlignAny(.NOT.(ASSOCIATED(A % ILUValues).OR.ASSOCIATED(A % CILUValues)))) THEN
             CALL PBR_FirstBuild(); PBRreb = .TRUE.
           ELSE
