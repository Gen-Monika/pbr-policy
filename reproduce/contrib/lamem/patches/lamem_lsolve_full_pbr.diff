--- a/src/lsolve.cpp
+++ b/src/lsolve.cpp
@@ -190,6 +190,46 @@
 	PetscFunctionReturn(0);
 }
 //---------------------------------------------------------------------------
+// PBR (preconditioner rebuild policy) bookkeeping
+//---------------------------------------------------------------------------
+#include "pbr_policy.h"
+static long     pbr_jac     = 0;
+static int      pbr_built   = 0;
+static int      pbr_in_guess = 0;
+static PetscInt pbr_ksp_its = 0;
+static double   pbr_ksp_ms  = 0.0, pbr_t0 = 0.0;
+static PetscErrorCode PBRPreSolve(KSP, Vec, Vec, void*)
+{ pbr_t0 = MPI_Wtime(); return 0; }
+static PetscErrorCode PBRPostSolve(KSP k, Vec, Vec, void*)
+{
+	PetscInt n = 0;
+	PetscCall(KSPGetIterationNumber(k, &n));
+	pbr_ksp_its += n;
+	double dt = 1e3*(MPI_Wtime() - pbr_t0);
+	// C1b ALIGNGATE: this broadcast used to be issued unconditionally, bypassing
+	// aspect::PBR::alignDouble().  With PBR_ALIGN=off that meant every rank still
+	// ran on rank 0's solve time, so the ablation arm never used per-rank local
+	// timing -- and solve_ms is the source of rho.  Route it through the gated
+	// helper: identical to the old behaviour when PBR_ALIGN=on, truly per-rank
+	// when PBR_ALIGN=off.
+	dt = aspect::PBR::alignDouble(dt, PETSC_COMM_WORLD);
+	pbr_ksp_ms += dt;
+	return 0;
+}
+PetscErrorCode PBRInstallHooks(SNES snes)
+{
+	static int done = 0;
+	aspect::PBR::init();
+	if(done || aspect::PBR::state().mode == "off") return 0;
+	KSP ksp;
+	PetscCall(SNESGetKSP(snes, &ksp));
+	PetscCall(KSPSetPreSolve (ksp, PBRPreSolve,  NULL));
+	PetscCall(KSPSetPostSolve(ksp, PBRPostSolve, NULL));
+	done = 1;
+	return 0;
+}
+//---------------------------------------------------------------------------
+//---------------------------------------------------------------------------
 PetscErrorCode PCDataSetup(PCData *pc, JacRes *jr)
 {
 	PetscFunctionBeginUser;
@@ -281,7 +321,66 @@
 		PetscCall(PMatMonoAssemble(&pc->pm));
 	}
 
-	PetscCall(MGSetup(&pc->mg));
+	// ---- PBR: the operator (fine-level matrix) is always updated above;
+	//      only the multigrid hierarchy (R, P, Galerkin coarse operators,
+	//      coarse LU, PCMG setup) is optionally kept from the last rebuild.
+	aspect::PBR::init();
+	if(aspect::PBR::state().mode == "off")
+	{
+		PetscCall(MGSetup(&pc->mg));
+		PetscFunctionReturn(0);
+	}
+
+	// The initial-guess solve (ctrl.initGuess) is a different linear problem:
+	// keep it outside the policy (always rebuild, not learned from) and force a
+	// rebuild at the first Jacobian of the real time stepping.
+	if(jr->ctrl.initGuess)
+	{
+		PetscCall(MGSetup(&pc->mg));
+		PetscCall(PCSetReusePreconditioner(pc->mg.pc, PETSC_FALSE));
+		pbr_in_guess = 1;
+		PetscPrintf(PETSC_COMM_WORLD, "PBR initguess rebuild (outside policy)\n");
+		PetscFunctionReturn(0);
+	}
+	if(pbr_in_guess)
+	{
+		pbr_in_guess = 0;
+		pbr_ksp_its = 0; pbr_ksp_ms = 0.0;   // discard the initial-guess solve
+		aspect::PBR::markMatrixReset();
+	}
+
+	if(pbr_jac > 0)
+	{
+		aspect::PBR::noteSolve((unsigned long)pbr_ksp_its, pbr_ksp_ms);
+		aspect::PBR::noteRatio();
+	}
+	PetscInt solIts = pbr_ksp_its;
+	pbr_ksp_its = 0; pbr_ksp_ms = 0.0;
+
+	int rb = aspect::PBR::decide(pbr_jac) ? 1 : 0;
+	// C1b: PBR_ALIGN=on (default) keeps the original unconditional behaviour;
+	// PBR_ALIGN=off leaves each rank with its own decision (ablation).
+	rb = aspect::PBR::alignInt(rb, PETSC_COMM_WORLD);
+
+	double bms = 0.0;
+	if(rb || !pbr_built)
+	{
+		double t0 = MPI_Wtime();
+		PetscCall(MGSetup(&pc->mg));
+		PetscCall(PCSetReusePreconditioner(pc->mg.pc, PETSC_FALSE));
+		PetscCall(PCSetUp(pc->mg.pc));
+		bms = 1e3*(MPI_Wtime() - t0);
+		bms = aspect::PBR::alignDouble(bms, PETSC_COMM_WORLD);
+		aspect::PBR::noteBuildTime(bms);
+		pbr_built = 1;
+	}
+	else
+	{
+		PetscCall(PCSetReusePreconditioner(pc->mg.pc, PETSC_TRUE));
+	}
+	PetscPrintf(PETSC_COMM_WORLD, "PBR jac %ld rebuild %d prev_its %" PetscInt_FMT " build_ms %.2f rMed %.3f\n",
+		pbr_jac, rb, solIts, bms, aspect::PBR::state().rMed);
+	pbr_jac++;
 
 	PetscFunctionReturn(0);
 }
