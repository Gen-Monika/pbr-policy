+    // C1 (2026-11-02): cross-rank alignment.
+    //   The decision is taken by a private state machine on every rank, and
+    //   rho is measured from this process' own wall clock, so the per-rank
+    //   decisions can in principle disagree. ASPECT builds its AMG
+    //   preconditioner collectively, so a disagreement would be fatal.
+    //   With PBR_ALIGN=on (default) rank 0's decision and rank 0's timings are
+    //   broadcast, making every rank carry identical policy state.
+    //   PBR_ALIGN=off restores the per-rank behaviour for ablation.
+    //   In serial every call below is a no-op, so results are unchanged.
+    inline bool alignEnabled()
+    {
+      static const bool a = (envS("PBR_ALIGN", "on") != "off");
+      return a;
+    }
+
+    inline int alignInt(const int v, MPI_Comm comm)
+    {
+      if (!alignEnabled()) return v;
+      int r = v;
+      MPI_Bcast(&r, 1, MPI_INT, 0, comm);
+      return r;
+    }
+
+    inline double alignDouble(const double v, MPI_Comm comm)
+    {
+      if (!alignEnabled()) return v;
+      double r = v;
+      MPI_Bcast(&r, 1, MPI_DOUBLE, 0, comm);
+      return r;
+    }
+
+    inline unsigned long alignULong(const unsigned long v, MPI_Comm comm)
+    {
+      if (!alignEnabled()) return v;
+      unsigned long r = v;
+      MPI_Bcast(&r, 1, MPI_UNSIGNED_LONG, 0, comm);
+      return r;
+    }
+
+    /** Align a rebuild decision; reports any pre-alignment disagreement. */
+    inline bool alignDecision(const bool local, MPI_Comm comm)
+    {
+      if (!alignEnabled()) return local;
+      int rank = 0;
+      MPI_Comm_rank(comm, &rank);
+      const int aligned = alignInt(local ? 1 : 0, comm) != 0;
+      if (aligned != local)
+        std::cout << "[PBR-ALIGN] rank=" << rank
+                  << " local=" << (local ? 1 : 0)
+                  << " adopted=" << (aligned ? 1 : 0) << std::endl;
+      return aligned;
+    }
+
