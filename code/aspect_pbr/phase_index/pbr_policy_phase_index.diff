+    inline void freezePhaseOffsets()
+    {
+      State &S = state();
+      if (!S.condIndex || S.offsetsFrozen) return;
+      S.offsetsFrozen = true;
+      bool changed = false;
+      const auto anchor = S.phaseLevels.find(0);
+      if (anchor != S.phaseLevels.end() && !anchor->second.empty())
